# Copy this file to .env and fill in real values.
# No local MongoDB? Run `npm run dev:mongo` for a disposable in-memory one — it
# listens on the exact MONGO_URI below.

MONGO_URI=mongodb://127.0.0.1:27017/glimpsehub
JWT_SECRET=replace-with-a-long-random-string
PORT=9000
NODE_ENV=development
HOME_URL=http://localhost:5173

# Cloudinary (image hosting) — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP (confirmation emails). For local testing, point at a catch-all like
# MailDev (`npx maildev`, SMTP on 1025, web UI on http://localhost:1080) —
# EMAIL_USERNAME/EMAIL_PASSWORD can be anything non-empty in that case.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_USERNAME=dev@example.com
EMAIL_PASSWORD=unused-with-maildev

# GitHub OAuth — currently unused (login path is commented out in
# authController.js / routes/auth.js), safe to leave as placeholders.
GITHUB_CLIENT_ID=unused
GITHUB_CLIENT_SECRET=unused
